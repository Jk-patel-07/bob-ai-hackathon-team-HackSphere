# =============================================================================
# Chip Design Knowledge Assistant — Environment Variables
# =============================================================================
# Copy this file to src/.env (or project root .env) and fill in your values.
# NEVER commit the .env file — it is already in .gitignore
# =============================================================================

# ── AI Provider Selection ────────────────────────────────────────────────────
# Supported values: gemini | watsonx
# Set to 'gemini' for Google Gemini API or 'watsonx' for IBM watsonx.ai
AI_PROVIDER=gemini

# ── Google Gemini credentials (REQUIRED when AI_PROVIDER=gemini) ─────────────
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── IBM watsonx.ai credentials (REQUIRED when AI_PROVIDER=watsonx) ───────────
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_LLM_MODEL_ID=ibm/granite-13b-instruct-v2
WATSONX_EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr

# ── Backend API ───────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# ── Vector store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=chip_design_knowledge

# ── MCP server → Backend ──────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── RAG tuning ────────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
