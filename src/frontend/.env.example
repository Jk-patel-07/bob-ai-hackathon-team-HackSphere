# Frontend environment configuration
# Copy this to .env.local and edit as needed.
# This file is safe to commit — it contains no secrets.

# Base URL for the FastAPI backend.
# Leave EMPTY for both local development and standard production:
#   - Development: Vite dev server proxies /health, /search, /categories, etc. to FastAPI (8000)
#   - Production:  FastAPI serves the React build on the same port — calls are same-origin
# Only set this if you deploy the backend on a different host/port than the frontend.
VITE_API_BASE_URL=
